{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=../ProektIntegrirani.Web/fplplanner.db;Cache=Shared"
  },
  "FplApi": {
    "BaseAddress": "https://fantasy.premierleague.com/api/",
    "TimeoutSeconds": 30,
    "CacheExpirationMinutes": 5,
    "SyncIntervalHours": 6
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "FplDataSyncedQueue": "fpl.data-synced",
    "ReconnectDelaySeconds": 30
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "Username": "YOUR_GMAIL_ADDRESS",
    "Password": "YOUR_GMAIL_APP_PASSWORD",
    "FromAddress": "YOUR_GMAIL_ADDRESS",
    "FromName": "FPL Planner",
    "UseSsl": true,
    "SendHoursBeforeDeadline": 24
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
